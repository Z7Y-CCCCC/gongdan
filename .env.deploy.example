## Copy this file to .env, then replace every change-* / example value before prod startup.
## The backend prod profile refuses to start with these placeholder secrets.

MYSQL_DATABASE=heihu_workorder
MYSQL_USER=heihu_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root
MYSQL_SERVER_ID=1
MYSQL_BINLOG_EXPIRE_LOGS_SECONDS=3024000

# Optional Redis password; applied consistently to Redis, its healthcheck and backend.
SPRING_REDIS_PASSWORD=

APP_SEED_FACTORY_CODE=HHGD
APP_SEED_FACTORY_NAME=Your Factory
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=change-admin
APP_SEED_ADMIN_NAME=System Admin
APP_SEED_SUPER_ADMIN_USERNAME=admin
APP_SEED_SUPER_ADMIN_PASSWORD=change-super-admin

APP_WECHAT_APP_ID=wx...
APP_WECHAT_SECRET=change-wechat-secret
APP_SMS_SENDER=http
APP_SMS_HTTP_URL=https://sms-gateway.example.com/send-code
APP_SMS_HTTP_AUTH_HEADER_NAME=Authorization
APP_SMS_HTTP_AUTH_HEADER_VALUE=Bearer change-sms-token
APP_SMS_HTTP_TEMPLATE=login_code
APP_SMS_HTTP_CONNECT_TIMEOUT_MS=3000
APP_SMS_HTTP_READ_TIMEOUT_MS=5000
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://workorder.example.com
APP_SESSION_TTL_MINUTES=720
APP_BINDING_DEFAULT_PASSWORD_LENGTH=12
APP_UPLOAD_STORAGE_TYPE=local
APP_UPLOAD_REPORT_IMAGE_DIR=/var/lib/heihu-workorder/report-images
APP_UPLOAD_S3_ENDPOINT=
APP_UPLOAD_S3_REGION=us-east-1
APP_UPLOAD_S3_BUCKET=
APP_UPLOAD_S3_ACCESS_KEY=
APP_UPLOAD_S3_SECRET_KEY=
APP_UPLOAD_S3_PATH_STYLE_ACCESS=true
APP_UPLOAD_S3_KEY_PREFIX=report-images
APP_UPLOAD_PENDING_IMAGE_TTL_HOURS=24
APP_UPLOAD_PENDING_IMAGE_CLEANUP_CRON=0 0 3 * * *
APP_PLUGIN_PROXY_CONNECT_TIMEOUT_MS=2000
APP_PLUGIN_PROXY_READ_TIMEOUT_MS=5000
APP_PLUGIN_PROXY_MAX_REQUEST_BYTES=1048576
APP_PLUGIN_GATEWAY_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHARACTER_SECRET
APP_PLUGIN_ALLOWED_BACKEND_HOSTS=quality-plugin,inspection-plugin
# Plugins must be hosted on separate origins, not the main application origin.
APP_PLUGIN_ALLOWED_FRONTEND_ORIGINS=https://quality.workorder.example.com,https://inspection.workorder.example.com
# Optional Superset embedded analytics. Leave empty to keep the new analysis page disabled.
APP_ANALYTICS_SUPERSET_URL=https://analytics.workorder.example.com
APP_ANALYTICS_SUPERSET_USERNAME=workorder-embed
APP_ANALYTICS_SUPERSET_PASSWORD=change-superset-service-password
APP_ANALYTICS_DASHBOARD_ID=
APP_ANALYTICS_TIMEOUT_SECONDS=5
# The Superset origin is build-time CSP configuration for the frontend image.
APP_ANALYTICS_ALLOWED_ORIGINS=https://analytics.workorder.example.com
APP_SYSTEM_LOG_RETENTION_DAYS=365
APP_SYSTEM_LOG_CLEANUP_CRON=0 30 3 * * *
APP_SLOW_REQUEST_THRESHOLD_MS=1000
APP_LOG_FILE=/var/log/heihu-workorder/backend.log
APP_LOG_MAX_FILE_SIZE=20MB
APP_LOG_MAX_HISTORY=30
APP_LOG_TOTAL_SIZE_CAP=500MB
APP_LOG_CLEAN_HISTORY_ON_START=true

SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=90MB

FRONTEND_PORT=8080
ALERT_WEBHOOK_URL=

# Optional read-only MCP diagnostics gateway. It is started only with:
# docker compose --profile mcp up --build -d mcp
MCP_PORT=9300
MCP_API_KEY=change-mcp-api-key
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_BACKEND_TIMEOUT_MS=10000
MCP_BACKEND_FACTORY_CODE=HHGD
MCP_BACKEND_USERNAME=mcp-diagnostics
MCP_BACKEND_PASSWORD=change-mcp-diagnostics-password
# MCP_BACKEND_TOKEN=
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGINS=

# Production backup baseline. BACKUP_SECONDARY_DIR and BACKUP_REMOTE_URI must
# point outside the production host. The remote bucket should have versioning
# and Object Lock enabled before BACKUP_REQUIRE_IMMUTABLE_REMOTE=true is used.
BACKUP_DIR=backups
BACKUP_SECONDARY_DIR=
BACKUP_RETENTION_DAYS=35
BACKUP_MAX_AGE_HOURS=26
BACKUP_MIN_FREE_GB=10
BINLOG_ARCHIVE_DIR=backups/binlogs
BINLOG_ARCHIVE_RETENTION_DAYS=35
BINLOG_ARCHIVE_MAX_AGE_MINUTES=10
BACKUP_REQUIRE_PITR=true
BACKUP_REQUIRE_OFFSITE=true
BACKUP_REMOTE_URI=s3://change-backup-bucket/gongdan/production
BACKUP_REMOTE_ENDPOINT_URL=
BACKUP_REMOTE_REGION=us-east-1
BACKUP_REMOTE_ACCESS_KEY=change-backup-access-key
BACKUP_REMOTE_SECRET_KEY=change-backup-secret-key
BACKUP_REMOTE_SESSION_TOKEN=
BACKUP_REMOTE_SSE=AES256
BACKUP_REMOTE_KMS_KEY_ID=
BACKUP_REMOTE_REQUIRED_LOCK_MODE=COMPLIANCE
BACKUP_REMOTE_MIN_RETENTION_DAYS=35
BACKUP_VERIFY_REMOTE_POLICY=true
BACKUP_REQUIRE_IMMUTABLE_REMOTE=true
# Optional external data sources. Empty allowlists deny all outbound connections.
# HTTP/SQLite only; network database adapters remain closed pending real-service acceptance.
# Keys: key-id:base64-encoded-32-byte-key (comma-separated ring; never commit real keys).
APP_EXTERNAL_DATA_KEYS=
APP_EXTERNAL_DATA_ACTIVE_KEY=
# Factory-scoped examples: 1@mes.example.com:443 and 1@10.20.0.15
APP_EXTERNAL_DATA_ALLOWED_TARGETS=
APP_EXTERNAL_DATA_ALLOWED_ADDRESSES=
APP_EXTERNAL_DATA_PLAINTEXT_TARGETS=
# SQLite requires a separately configured read-only volume and factory@file-id registration.
APP_EXTERNAL_DATA_SQLITE_ROOT=
APP_EXTERNAL_DATA_SQLITE_FILES=
