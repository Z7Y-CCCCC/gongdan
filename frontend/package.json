{
  "name": "heihu-workorder-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "npm run test:ui-contract && npm run test:plugin-ui && npm run test:i18n-contract",
    "test:ui-contract": "node --test scripts/audit-icon-controls.test.mjs && node scripts/audit-icon-controls.mjs --check",
    "test:plugin-ui": "node --test scripts/plugin-ui-functional.test.mjs",
    "test:i18n-contract": "node --test scripts/ui-i18n-transform.test.mjs",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "qrcode": "^1.5.4",
    "vue": "^3.5.42"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest",
    "source-map-js": "^1.2.2",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "js-beautify@1": {
      "glob": "14.0.2",
      "editorconfig": {
        "minimatch": "11.0.5"
      }
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "2.4.11",
    "fast-check": "^3.0.0",
    "jsdom": "^24.0.0",
    "typescript": "~5.7.2",
    "vite": "6.4.6",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  }
}
