{
  "name": "heihu-workorder-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.0",
    "fast-check": "^3.0.0",
    "jsdom": "^24.0.0",
    "typescript": "~5.7.2",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "vue-tsc": "^2.2.0"
  }
}
