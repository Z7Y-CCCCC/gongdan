# Copy to gongdan.env and replace every CHANGE_ME value before starting.
SPRING_PROFILES_ACTIVE=demo
SERVER_PORT=18080
SERVER_ADDRESS=127.0.0.1

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/heihu_workorder_demo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

APP_SEED_FACTORY_CODE=HHGD
APP_SEED_FACTORY_NAME=Internal Demo Factory
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
APP_SEED_ADMIN_NAME=Demo Admin
APP_SEED_SUPER_ADMIN_USERNAME=admin
APP_SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_SUPER_ADMIN_PASSWORD

APP_WECHAT_MOCK_ENABLED=true
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*:*,http://10.*:*,http://172.*:*
APP_UPLOAD_REPORT_IMAGE_DIR=C:/www/gongdan/data/uploads
APP_SESSION_TTL_MINUTES=720
# Optional explicit trusted proxy IP/CIDR list; empty ignores forwarding headers.
APP_NETWORK_TRUSTED_PROXIES=
# Retain local HTTP compatibility. Direct TLS still marks native report cookies Secure.
APP_UREPORT_COOKIE_SECURE=false
APP_SYSTEM_LOG_RETENTION_DAYS=365
APP_SYSTEM_LOG_CLEANUP_CRON=0 30 3 * * *
APP_SLOW_REQUEST_THRESHOLD_MS=1000
APP_LOG_FILE=C:/www/gongdan/logs/backend.log
APP_LOG_MAX_FILE_SIZE=20MB
APP_LOG_MAX_HISTORY=30
APP_LOG_TOTAL_SIZE_CAP=500MB
APP_LOG_CLEAN_HISTORY_ON_START=true

# Internal demo monitoring. A missing backup is reported after this age.
MONITOR_FRONTEND_URL=http://127.0.0.1:8088/
MONITOR_MOBILE_URL=http://127.0.0.1:8088/mobile/
MONITOR_HEALTH_URL=http://127.0.0.1:8088/health
MONITOR_BACKUP_MAX_AGE_HOURS=30
MONITOR_MIN_FREE_GB=2
MONITOR_ALERT_COOLDOWN_MINUTES=30
ALERT_WEBHOOK_URL=

# Windows maintenance task settings
MYSQL_SERVICE_NAME=MySQL92
BACKUP_DIR=C:/www/gongdan/data/backups
BACKUP_RETENTION_DAYS=30
LOG_RETENTION_DAYS=30
BACKUP_MYSQL_EXE=
BACKUP_SECONDARY_DIR=
NGINX_SERVICE_NAME=
NGINX_EXE=
NGINX_CONFIG_DIR=

# Set this only when java.exe is not available in PATH.
JAVA_EXE=
