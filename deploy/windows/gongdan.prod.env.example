# Commercial Windows deployment template. Copy to config/gongdan.env and replace placeholders.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=18080
SERVER_ADDRESS=127.0.0.1

# Use MySQL 8.4 LTS with the current Java 8 / Spring Boot 2.7 / Flyway stack.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/heihu_workorder?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=true
SPRING_DATASOURCE_USERNAME=heihu_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD_16_CHARS
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

APP_SEED_FACTORY_CODE=HHGD
APP_SEED_FACTORY_NAME=CHANGE_ME_FACTORY_NAME
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=CHANGE_ME_FACTORY_ADMIN_PASSWORD
APP_SEED_ADMIN_NAME=System Admin
APP_SEED_SUPER_ADMIN_USERNAME=admin
APP_SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_DIFFERENT_SUPER_PASSWORD

APP_WECHAT_MOCK_ENABLED=false
APP_WECHAT_APP_ID=CHANGE_ME_WECHAT_APP_ID
APP_WECHAT_SECRET=CHANGE_ME_WECHAT_SECRET
APP_SMS_SENDER=http
APP_SMS_HTTP_URL=https://CHANGE_ME_SMS_GATEWAY/send-code
APP_SMS_HTTP_AUTH_HEADER_NAME=Authorization
APP_SMS_HTTP_AUTH_HEADER_VALUE=Bearer CHANGE_ME_SMS_TOKEN
APP_SMS_HTTP_TEMPLATE=login_code
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://CHANGE_ME_DOMAIN

APP_SESSION_TTL_MINUTES=720
APP_BINDING_DEFAULT_PASSWORD_LENGTH=12
APP_UPLOAD_STORAGE_TYPE=local
APP_UPLOAD_REPORT_IMAGE_DIR=C:/www/gongdan/data/uploads
APP_UPLOAD_S3_ENDPOINT=
APP_UPLOAD_S3_REGION=us-east-1
APP_UPLOAD_S3_BUCKET=
APP_UPLOAD_S3_ACCESS_KEY=
APP_UPLOAD_S3_SECRET_KEY=
APP_UPLOAD_S3_PATH_STYLE_ACCESS=true
APP_UPLOAD_S3_KEY_PREFIX=report-images
APP_UPLOAD_PENDING_IMAGE_TTL_HOURS=24
APP_UPLOAD_PENDING_IMAGE_CLEANUP_CRON=0 0 3 * * *
APP_PLUGIN_PROXY_CONNECT_TIMEOUT_MS=2000
APP_PLUGIN_PROXY_READ_TIMEOUT_MS=5000
APP_PLUGIN_PROXY_MAX_REQUEST_BYTES=1048576
APP_PLUGIN_GATEWAY_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHARACTER_SECRET
APP_PLUGIN_ALLOWED_BACKEND_HOSTS=127.0.0.1
APP_PLUGIN_ALLOWED_FRONTEND_ORIGINS=https://CHANGE_ME_DOMAIN

APP_SYSTEM_LOG_RETENTION_DAYS=365
APP_SYSTEM_LOG_CLEANUP_CRON=0 30 3 * * *
APP_SLOW_REQUEST_THRESHOLD_MS=1000
APP_LOG_FILE=C:/www/gongdan/logs/backend.log
APP_LOG_MAX_FILE_SIZE=20MB
APP_LOG_MAX_HISTORY=30
APP_LOG_TOTAL_SIZE_CAP=500MB
APP_LOG_CLEAN_HISTORY_ON_START=true

MYSQL_SERVICE_NAME=MySQL84
BACKUP_DIR=C:/www/gongdan/data/backups
BACKUP_SECONDARY_DIR=CHANGE_ME_SECOND_DISK_OR_NAS_PATH
BACKUP_RETENTION_DAYS=35
BACKUP_MYSQL_USER=CHANGE_ME_DEDICATED_BACKUP_USER
BACKUP_MYSQL_PASSWORD=CHANGE_ME_DEDICATED_BACKUP_PASSWORD
RESTORE_MYSQL_USER=CHANGE_ME_DEDICATED_RESTORE_USER
RESTORE_MYSQL_PASSWORD=CHANGE_ME_DEDICATED_RESTORE_PASSWORD
LOG_RETENTION_DAYS=30
BACKUP_MYSQL_EXE=
BACKUP_MYSQL_CLIENT_EXE=
BACKUP_MYSQL_BINLOG_EXE=
BINLOG_ARCHIVE_DIR=C:/www/gongdan/data/backups/binlogs
BINLOG_ARCHIVE_RETENTION_DAYS=35
BINLOG_ARCHIVE_MAX_AGE_MINUTES=10
BACKUP_REQUIRE_PITR=true
BACKUP_REMOTE_URI=s3://CHANGE_ME_BACKUP_BUCKET/gongdan/production
BACKUP_REMOTE_ENDPOINT_URL=
BACKUP_REMOTE_REGION=us-east-1
BACKUP_REMOTE_ACCESS_KEY=CHANGE_ME_BACKUP_ACCESS_KEY
BACKUP_REMOTE_SECRET_KEY=CHANGE_ME_BACKUP_SECRET_KEY
BACKUP_REMOTE_SESSION_TOKEN=
BACKUP_REMOTE_SSE=AES256
BACKUP_REMOTE_KMS_KEY_ID=
BACKUP_REMOTE_REQUIRED_LOCK_MODE=COMPLIANCE
BACKUP_REMOTE_MIN_RETENTION_DAYS=35
BACKUP_VERIFY_REMOTE_POLICY=true
BACKUP_REQUIRE_IMMUTABLE_REMOTE=true
BACKUP_REQUIRE_OFFSITE=true

NGINX_SERVICE_NAME=
NGINX_EXE=C:/nginx/nginx.exe
NGINX_CONFIG_DIR=C:/nginx
JAVA_EXE=

MONITOR_FRONTEND_URL=https://CHANGE_ME_DOMAIN/
MONITOR_MOBILE_URL=https://CHANGE_ME_DOMAIN/mobile/
MONITOR_HEALTH_URL=https://CHANGE_ME_DOMAIN/health
MONITOR_BACKUP_MAX_AGE_HOURS=30
MONITOR_MIN_FREE_GB=5
MONITOR_ALERT_COOLDOWN_MINUTES=30
ALERT_WEBHOOK_URL=
