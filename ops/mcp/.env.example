# MCP gateway
NODE_ENV=production
MCP_HOST=127.0.0.1
MCP_PORT=9300
MCP_API_KEY=replace-with-a-long-random-secret
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_BACKEND_TIMEOUT_MS=10000

# Use a dedicated enabled admin account for diagnostics. Do not reuse the
# human administrator account because the backend invalidates older sessions
# when the same account signs in again.
MCP_BACKEND_URL=http://backend:8080
MCP_BACKEND_FACTORY_CODE=HHGD
MCP_BACKEND_USERNAME=mcp-diagnostics
MCP_BACKEND_PASSWORD=replace-with-dedicated-admin-password

# Alternatively provide a pre-issued backend Bearer token. When set, the
# username/password login flow is skipped.
# MCP_BACKEND_TOKEN=

# Optional DNS rebinding / browser-origin protections. Keep empty when the
# service is private and called by an MCP client over a trusted network.
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGINS=https://agent.example.com
