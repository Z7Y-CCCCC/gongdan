# H5 can use /api through the same reverse proxy.
# WeChat Mini Program production builds must use an absolute HTTPS API URL.
VITE_API_BASE_URL=https://workorder.example.com/api

# H5 uses /api/auth/login with factory/account/password, not a mock WeChat identity.
# Set true only for Mini Program development with backend app.wechat.mock-enabled=true.
VITE_WECHAT_MOCK_ENABLED=false

# Development/preview only. Set a trusted LAN interface explicitly if required;
# never expose the legacy compiler's development server to the public Internet.
VITE_DEV_HOST=127.0.0.1
